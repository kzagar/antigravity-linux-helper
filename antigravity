#!/usr/bin/env python3
# pylint: disable=too-many-lines
"""Launcher and auto-updater for Google Antigravity and Antigravity IDE.

Detects which application to run from argv[0], checks for updates at most
once per hour, performs an atomic installation under /opt or ~/.local/opt/,
and exec-replaces itself with the installed binary.
"""

import datetime
import gzip
import json
import os
import platform
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import urllib.request

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

DOWNLOAD_PAGE_URL = "https://antigravity.google/download"
BASE_URL = "https://antigravity.google"
BRAND_LOGO_URL = (
    "https://antigravity.google/assets/image/brand/antigravity-icon__full-color.png"
)

# Section IDs as embedded in the download-page JS bundle
APP_SECTION_IDS = {
    "antigravity": "antigravity-2",
    "antigravity-ide": "antigravity-ide",
}

# Maximum time (seconds) to wait for an archive download before giving up
DOWNLOAD_TIMEOUT = 600

# URL of the canonical repository script for self-updates
SELF_UPDATE_URL = (
    "https://raw.githubusercontent.com/kzagar/antigravity-linux-helper/"
    "refs/heads/main/antigravity"
)


# ---------------------------------------------------------------------------
# User / permission helpers
# ---------------------------------------------------------------------------


def get_user_home():
    """Return the home directory of the invoking user, handling sudo."""
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user:
        import pwd  # pylint: disable=import-outside-toplevel

        try:
            return pwd.getpwnam(sudo_user).pw_dir
        except KeyError:
            pass
    return os.path.expanduser("~")


def get_user_uid_gid():
    """Return the (uid, gid) of the invoking user, handling sudo."""
    sudo_uid = os.environ.get("SUDO_UID")
    sudo_gid = os.environ.get("SUDO_GID")
    if sudo_uid and sudo_gid:
        return int(sudo_uid), int(sudo_gid)
    return os.getuid(), os.getgid()


def chown_to_user(path):
    """Recursively chown *path* to the invoking user (no-op when not root)."""
    if os.getuid() != 0:
        return
    uid, gid = get_user_uid_gid()
    try:
        if os.path.isdir(path):
            os.chown(path, uid, gid)
            for root, dirs, files in os.walk(path):
                for name in dirs:
                    os.chown(os.path.join(root, name), uid, gid)
                for name in files:
                    os.chown(os.path.join(root, name), uid, gid)
        else:
            os.chown(path, uid, gid)
    except OSError as exc:
        print(f"Warning: Failed to chown {path} to user: {exc}", file=sys.stderr)


def can_use_sudo():
    """Return True if sudo is available and can be executed without password."""
    if os.getuid() == 0:
        return True
    if not shutil.which("sudo"):
        return False
    try:
        res = subprocess.run(
            ["sudo", "-n", "true"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=2,
        )
        return res.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def is_privileged_mode():
    """Return True if installation should target system directories (/opt, /usr/local/bin)."""
    env_mode = os.environ.get("ANTIGRAVITY_INSTALL_MODE", "").lower()
    if env_mode in ("user", "local"):
        return False
    if env_mode in ("system", "global", "opt"):
        return True
    if "--user" in sys.argv:
        return False
    if "--system" in sys.argv:
        return True
    return can_use_sudo()


def get_install_paths(privileged=None):
    """Return dict of target paths (opt_dir, bin_dir, apps_dir) based on mode."""
    if privileged is None:
        privileged = is_privileged_mode()
    if privileged:
        return {
            "opt_dir": "/opt",
            "bin_dir": "/usr/local/bin",
            "apps_dir": "/usr/local/share/applications",
            "privileged": True,
        }
    user_home = get_user_home()
    return {
        "opt_dir": os.path.join(user_home, ".local", "opt"),
        "bin_dir": os.path.join(user_home, ".local", "bin"),
        "apps_dir": os.path.join(user_home, ".local", "share", "applications"),
        "privileged": False,
    }


def make_world_readable(path):
    """Ensure *path* and contents are world-readable and directories world-executable."""
    try:
        if os.path.isdir(path):
            for root, dirs, files in os.walk(path):
                for d in dirs:
                    dir_path = os.path.join(root, d)
                    st = os.stat(dir_path)
                    os.chmod(dir_path, st.st_mode | 0o755)
                for f in files:
                    file_path = os.path.join(root, f)
                    st = os.stat(file_path)
                    if st.st_mode & 0o111:
                        os.chmod(file_path, st.st_mode | 0o755)
                    else:
                        os.chmod(file_path, st.st_mode | 0o644)
        else:
            st = os.stat(path)
            if st.st_mode & 0o111:
                os.chmod(path, st.st_mode | 0o755)
            else:
                os.chmod(path, st.st_mode | 0o644)
    except OSError as exc:
        print(f"Warning: Failed to set permissions on {path}: {exc}", file=sys.stderr)


def configure_chrome_sandbox(app_dir):
    """If running as root, configure chrome-sandbox with root ownership and 4755 permissions."""
    if os.getuid() != 0:
        return
    sandbox_path = find_file_recursive(app_dir, "chrome-sandbox")
    if sandbox_path:
        try:
            os.chown(sandbox_path, 0, 0)
            os.chmod(sandbox_path, 0o4755)
        except OSError as exc:
            print(
                f"Warning: Failed to set SUID permissions on {sandbox_path}: {exc}",
                file=sys.stderr,
            )


def resolve_app_dir(app_name):
    """Return the installed application directory, checking /opt then ~/.local/opt."""
    user_home = get_user_home()
    candidates = [
        os.path.join("/opt", app_name),
        os.path.join(user_home, ".local", "opt", app_name),
    ]
    for c in candidates:
        if find_file_recursive(c, app_name, is_executable=True):
            return c
    paths = get_install_paths()
    return os.path.join(paths["opt_dir"], app_name)


# ---------------------------------------------------------------------------
# Filesystem search helpers
# ---------------------------------------------------------------------------


def find_file_recursive(dir_path, name, is_executable=False):
    """Return the shallowest file named *name* under *dir_path*.

    When *is_executable* is True only executable files are considered.
    Returns ``None`` if no match is found.
    """
    matches = []
    for root, _, files in os.walk(dir_path):
        if name in files:
            full_path = os.path.join(root, name)
            if not is_executable or os.access(full_path, os.X_OK):
                matches.append((full_path.count(os.sep), full_path))
    if matches:
        return min(matches)[1]
    return None


def find_icon_recursive(dir_path, app_name):
    """Return the best-scored PNG/SVG icon found under *dir_path*.

    Scoring heuristic (higher wins):
      ``code``     → +10
      ``logo``     → +8
      ``icon``     → +6
      *app_name*   → +5

    Returns ``None`` when no image file is found.
    """
    candidates = []
    for root, _, files in os.walk(dir_path):
        for name in files:
            if not name.lower().endswith((".png", ".svg")):
                continue
            lower = name.lower()
            score = 0
            if "code" in lower:
                score += 10
            if "logo" in lower:
                score += 8
            if "icon" in lower:
                score += 6
            if app_name in lower:
                score += 5
            candidates.append((score, os.path.join(root, name)))
    if candidates:
        return max(candidates)[1]
    return None


def is_sandbox_usable(app_dir):
    """Check if Chromium/Electron sandbox can be used on this system.

    Returns True if:
      - chrome-sandbox exists, is owned by root, and has mode 4755 (SUID), OR
      - chrome-sandbox does not exist AND unprivileged user namespaces are functional.
    Returns False otherwise.
    """
    sandbox_path = find_file_recursive(app_dir, "chrome-sandbox")
    if sandbox_path:
        try:
            st = os.stat(sandbox_path)
            return st.st_uid == 0 and bool(st.st_mode & stat.S_ISUID)
        except OSError:
            return False

    for proc_path in (
        "/proc/sys/kernel/unprivileged_userns_clone",
        "/proc/sys/user/max_user_namespaces",
    ):
        if os.path.exists(proc_path):
            try:
                with open(proc_path, "r", encoding="utf-8") as fh:
                    if fh.read().strip() == "0":
                        return False
            except OSError:
                pass

    try:
        pid = os.fork()
        if pid == 0:
            try:
                os.unshare(getattr(os, "CLONE_NEWUSER", 0x10000000))
                os._exit(0)
            except OSError:
                os._exit(1)
        else:
            _, status = os.waitpid(pid, 0)
            return os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0
    except (OSError, AttributeError):
        return False


is_sandbox_configured = is_sandbox_usable


# ---------------------------------------------------------------------------
# HTTP helper
# ---------------------------------------------------------------------------


def fetch_url(url, method="GET", headers=None, timeout=10):
    """Fetch *url* and return ``(body_bytes, http_info)``.

    Transparently decompresses gzip-encoded responses.
    """
    if headers is None:
        headers = {}
    headers.setdefault(
        "User-Agent", "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"
    )
    headers.setdefault("Accept-Encoding", "gzip, deflate")

    req = urllib.request.Request(url, method=method, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as response:
        info = response.info()
        data = response.read()
        if info.get("Content-Encoding") == "gzip" and data:
            data = gzip.decompress(data)
        return data, info


# ---------------------------------------------------------------------------
# Release discovery
# ---------------------------------------------------------------------------


def get_linux_platform():
    """Return the platform token used in download URLs (``linux-x64`` / ``linux-arm``)."""
    return "linux-arm" if platform.machine() in ("aarch64", "arm64") else "linux-x64"


def discover_download_url(app_name):  # pylint: disable=too-many-locals
    """Scrape the download page to find the Linux download URL for *app_name*.

    Strategy
    --------
    1. Fetch :data:`DOWNLOAD_PAGE_URL`.
    2. Check HTML for the product's platforms section.
    3. If not in HTML, locate script bundles and search within them.
    4. Extract the Linux href matching the host architecture.
    5. Issue a HEAD request to obtain the ``Last-Modified`` timestamp.

    Returns
    -------
    (download_url, last_modified) : (str, str)
    """
    # 1. Fetch the download page
    try:
        html = fetch_url(DOWNLOAD_PAGE_URL)[0].decode("utf-8", errors="ignore")
    except Exception as exc:
        raise RuntimeError(f"Failed to fetch download page: {exc}") from exc

    section_id = APP_SECTION_IDS[app_name]
    r_platform = get_linux_platform()
    section_pat = re.compile(r'id[:=]["\']?' + re.escape(section_id) + r'["\']?')

    content = None

    # 2. Check HTML for section first
    if section_pat.search(html):
        content = html
    else:
        # 3. Locate and search script bundles
        js_files = re.findall(r'src=["\']([^"\']+\.js[^"\']*)["\']', html)
        for js_path in js_files:
            if js_path.startswith("http"):
                js_url = js_path
            else:
                js_url = BASE_URL + "/" + js_path.lstrip("/")
            try:
                js_content = fetch_url(js_url)[0].decode("utf-8", errors="ignore")
                if section_pat.search(js_content):
                    content = js_content
                    break
            except Exception:  # pylint: disable=broad-exception-caught
                continue

    if content is None:
        raise RuntimeError(
            f"Could not find download section '{section_id}' in page HTML or JS bundles"
        )

    # 4. Extract section window and Linux href
    section_match = section_pat.search(content)
    assert section_match is not None

    window_start = section_match.start()
    next_section_pat = re.compile(r'id[:=]["\']?antigravity-')
    next_match = next_section_pat.search(content, section_match.end())
    window_end = (
        next_match.start() if next_match else min(window_start + 50_000, len(content))
    )
    window = content[window_start:window_end]

    # Extract hrefs containing the target platform token
    hrefs = re.findall(
        r'href[:=]\s*["\']?(https?://[^"\'\s>]+'
        + re.escape(r_platform)
        + r'[^"\'\s>]+)["\']?',
        window,
    )
    if not hrefs:
        raise RuntimeError(
            f"No Linux ({r_platform}) download link found for '{app_name}' "
            f"in section '{section_id}'"
        )

    download_url = hrefs[0]

    # 5. HEAD request for Last-Modified timestamp
    try:
        _, info = fetch_url(download_url, method="HEAD")
        last_modified = info.get("Last-Modified")
    except Exception as exc:
        raise RuntimeError(
            f"Failed to verify release headers for {download_url}: {exc}"
        ) from exc

    return download_url, last_modified


# ---------------------------------------------------------------------------
# Self-update and self-installation
# ---------------------------------------------------------------------------


def self_update():  # pylint: disable=too-many-branches,too-many-statements
    """Check if the remote script on GitHub differs from the running copy and re-exec."""
    script_path = shutil.which(sys.argv[0]) or os.path.abspath(sys.argv[0])
    target_file = os.path.realpath(script_path)

    if not os.path.isfile(target_file):
        return

    try:
        with open(target_file, "rb") as fh:
            local_data = fh.read()
    except OSError as exc:
        print(
            f"Warning: Failed to read current script for self-update check: {exc}",
            file=sys.stderr,
        )
        return

    try:
        remote_data, _ = fetch_url(SELF_UPDATE_URL, timeout=10)
    except Exception as exc:  # pylint: disable=broad-exception-caught
        print(
            f"Warning: Failed to check for script self-update: {exc}",
            file=sys.stderr,
        )
        return

    if not remote_data or remote_data == local_data:
        return

    print("Updating antigravity launcher script to latest version from GitHub...")

    if not os.access(target_file, os.W_OK) and can_use_sudo():
        with tempfile.NamedTemporaryFile(delete=False) as tf:
            tf.write(remote_data)
            tmp_file = tf.name
        try:
            os.chmod(tmp_file, 0o755)
            res = subprocess.run(
                ["sudo", "-n", "cp", tmp_file, target_file],
                check=False,
            )
            if res.returncode == 0:
                subprocess.run(["sudo", "-n", "chmod", "755", target_file], check=False)
                print("Script updated successfully. Restarting...")
                os.execv(sys.executable, [sys.executable, script_path] + sys.argv[1:])
        except OSError as exc:
            print(f"Warning: Failed to update script via sudo: {exc}", file=sys.stderr)
        finally:
            if os.path.exists(tmp_file):
                try:
                    os.remove(tmp_file)
                except OSError:
                    pass
        return

    tmp_file = target_file + ".tmp"
    try:
        with open(tmp_file, "wb") as fh:
            fh.write(remote_data)
        os.chmod(tmp_file, 0o755)
        chown_to_user(tmp_file)
        os.replace(tmp_file, target_file)
    except OSError as exc:
        print(f"Warning: Failed to write updated script: {exc}", file=sys.stderr)
        if os.path.exists(tmp_file):
            try:
                os.remove(tmp_file)
            except OSError:
                pass
        return

    print("Script updated successfully. Restarting...")
    try:
        os.execv(sys.executable, [sys.executable, script_path] + sys.argv[1:])
    except OSError as exc:
        print(f"Error: Failed to re-exec updated script: {exc}", file=sys.stderr)
        sys.exit(1)


def self_install(
    privileged=None,
):  # pylint: disable=too-many-branches,too-many-statements
    """Copy this script to target bin directory and create the IDE symlink.

    Skips gracefully when already running from the installed path.
    """
    paths = get_install_paths(privileged)
    bin_dir = paths["bin_dir"]
    target_script = os.path.join(bin_dir, "antigravity")
    target_symlink = os.path.join(bin_dir, "antigravity-ide")
    curr_script = os.path.abspath(sys.argv[0])

    # Check if we are already running from the installed path
    if os.path.realpath(curr_script) == os.path.realpath(target_script):
        if not os.path.lexists(target_symlink):
            if paths["privileged"] and os.getuid() != 0 and can_use_sudo():
                try:
                    subprocess.run(
                        ["sudo", "-n", "ln", "-sf", "antigravity", target_symlink],
                        check=False,
                    )
                except (OSError, subprocess.SubprocessError) as exc:
                    print(
                        f"Warning: Could not create symlink {target_symlink}: {exc}",
                        file=sys.stderr,
                    )
            else:
                try:
                    os.symlink("antigravity", target_symlink)
                except OSError as exc:
                    print(
                        f"Warning: Could not create symlink {target_symlink}: {exc}",
                        file=sys.stderr,
                    )
        return

    # Check if target_script already matches curr_script
    should_copy = True
    if os.path.exists(target_script):
        try:
            with open(curr_script, "rb") as f1, open(target_script, "rb") as f2:
                should_copy = f1.read() != f2.read()
        except OSError:
            pass

    if paths["privileged"] and os.getuid() != 0:
        if can_use_sudo():
            if should_copy:
                try:
                    subprocess.run(
                        ["sudo", "-n", "mkdir", "-p", bin_dir],
                        check=False,
                    )
                    res = subprocess.run(
                        ["sudo", "-n", "cp", curr_script, target_script],
                        check=False,
                    )
                    if res.returncode == 0:
                        subprocess.run(
                            ["sudo", "-n", "chmod", "755", target_script],
                            check=False,
                        )
                except (OSError, subprocess.SubprocessError) as exc:
                    print(
                        f"Warning: Could not self-install script to {target_script}: {exc}",
                        file=sys.stderr,
                    )
            if not os.path.lexists(target_symlink):
                try:
                    subprocess.run(
                        ["sudo", "-n", "ln", "-sf", "antigravity", target_symlink],
                        check=False,
                    )
                except (OSError, subprocess.SubprocessError) as exc:
                    print(
                        f"Warning: Could not create symlink {target_symlink}: {exc}",
                        file=sys.stderr,
                    )
        else:
            if should_copy:
                try:
                    os.makedirs(bin_dir, exist_ok=True)
                    shutil.copy2(curr_script, target_script)
                    os.chmod(target_script, 0o755)
                except OSError as exc:
                    print(
                        f"Warning: Could not self-install script to {target_script}: {exc}",
                        file=sys.stderr,
                    )
            if not os.path.lexists(target_symlink):
                try:
                    os.symlink("antigravity", target_symlink)
                except OSError as exc:
                    print(
                        f"Warning: Could not create symlink {target_symlink}: {exc}",
                        file=sys.stderr,
                    )
        return

    # User-mode or running as root
    os.makedirs(bin_dir, exist_ok=True)
    if not paths["privileged"]:
        chown_to_user(bin_dir)

    if should_copy:
        try:
            shutil.copy2(curr_script, target_script)
            os.chmod(target_script, 0o755)
            if not paths["privileged"]:
                chown_to_user(target_script)
        except OSError as exc:
            print(
                f"Warning: Could not self-install script to {target_script}: {exc}",
                file=sys.stderr,
            )

    if not os.path.lexists(target_symlink):
        try:
            os.symlink("antigravity", target_symlink)
            if not paths["privileged"]:
                chown_to_user(target_symlink)
        except OSError as exc:
            print(
                f"Warning: Could not create symlink {target_symlink}: {exc}",
                file=sys.stderr,
            )


# ---------------------------------------------------------------------------
# Update logic
# ---------------------------------------------------------------------------


def _is_update_due(last_check_file):
    """Return True if no check has been recorded or the last one is ≥ 1 hour ago."""
    if not os.path.exists(last_check_file):
        return True
    try:
        with open(last_check_file, "r", encoding="utf-8") as fh:
            timestamp = float(fh.read().strip())
        age = (
            datetime.datetime.now() - datetime.datetime.fromtimestamp(timestamp)
        ).total_seconds()
        return age >= 3600
    except (OSError, ValueError):
        return True


def _save_check_timestamp(config_dir, last_check_file):
    """Persist the current timestamp as the last-checked time."""
    os.makedirs(config_dir, exist_ok=True)
    chown_to_user(config_dir)
    try:
        with open(last_check_file, "w", encoding="utf-8") as fh:
            fh.write(str(datetime.datetime.now().timestamp()))
        chown_to_user(last_check_file)
    except OSError:
        pass


def _render_progress_bar(label, done, total, width=30):
    """Print an overwriting progress bar line to stdout.

    ``label``  – short prefix shown before the bar (e.g. "Downloading").
    ``done``   – units completed so far.
    ``total``  – total units (0 or None renders an indeterminate spinner).
    ``width``  – number of fill characters in the bar.
    """
    if total:
        filled = int(width * done / total)
        fill = "#" * filled + "-" * (width - filled)
        pct = done * 100 // total
        print(f"\r  {label} [{fill}] {pct:3d}%", end="", flush=True)
    else:
        spinner = r"-\|/"[done % 4]
        fill = "-" * width
        print(f"\r  {label} [{fill}] {spinner}", end="", flush=True)


def _download_and_extract(
    download_url, app_name, new_dir, opt_dir
):  # pylint: disable=too-many-locals
    """Download the archive and extract it (minus the top-level directory) into *new_dir*.

    Returns the path to the resolved executable on success.
    Raises RuntimeError on any failure.
    """
    temp_archive = os.path.join(opt_dir, f"{app_name}_temp.tar.gz")
    try:
        req = urllib.request.Request(
            download_url, headers={"User-Agent": "Mozilla/5.0"}
        )
        with (
            urllib.request.urlopen(req, timeout=DOWNLOAD_TIMEOUT) as response,
            open(temp_archive, "wb") as out_file,
        ):
            raw_total = response.info().get("Content-Length")
            total_bytes = int(raw_total) if raw_total else None
            downloaded = 0
            chunk_size = 1024 * 1024  # 1 MB
            while True:
                chunk = response.read(chunk_size)
                if not chunk:
                    break
                out_file.write(chunk)
                downloaded += len(chunk)
                _render_progress_bar("Downloading...", downloaded, total_bytes)
        print()

        with tarfile.open(temp_archive, "r:gz") as tar:
            safe_members = []
            for member in tar.getmembers():
                parts = member.name.split("/")
                if len(parts) <= 1:
                    continue  # skip top-level directory entry itself
                member.name = "/".join(parts[1:])
                # Reject path-traversal attempts
                if member.name.startswith("/") or ".." in member.name.split("/"):
                    continue
                safe_members.append(member)
            total_members = len(safe_members)
            extract_kwargs = (
                {"filter": "data"} if hasattr(tarfile, "data_filter") else {}
            )
            for i, member in enumerate(safe_members, 1):
                tar.extract(member, path=new_dir, **extract_kwargs)
                _render_progress_bar("Unpacking... ", i, total_members)
        print()

        resolved_bin = find_file_recursive(new_dir, app_name, is_executable=True)
        if not resolved_bin:
            raise RuntimeError(
                f"Executable '{app_name}' not found in extracted archive"
            )
        return resolved_bin

    finally:
        if os.path.exists(temp_archive):
            os.remove(temp_archive)


class Updater:
    """Builder-pattern class for managing atomic application updates."""

    def __init__(self, app_name):
        self.app_name = app_name
        self.download_url = None
        self.remote_last_modified = None
        self.new_dir = None
        self.old_dir = None
        self.app_dir = None
        self.opt_dir = None

    def set_download_url(self, url):
        """Set the download URL for the application archive."""
        self.download_url = url
        return self

    def set_remote_last_modified(self, timestamp):
        """Set the remote Last-Modified timestamp."""
        self.remote_last_modified = timestamp
        return self

    def set_new_dir(self, path):
        """Set the temporary directory for the new installation."""
        self.new_dir = path
        return self

    def set_old_dir(self, path):
        """Set the backup directory for the old installation."""
        self.old_dir = path
        return self

    def set_app_dir(self, path):
        """Set the final installation directory."""
        self.app_dir = path
        return self

    def set_opt_dir(self, path):
        """Set the root opt directory."""
        self.opt_dir = path
        return self

    def perform(self):
        """Download, extract, atomically install, and write desktop entry."""
        try:
            _download_and_extract(
                self.download_url, self.app_name, self.new_dir, self.opt_dir
            )
            metadata = {
                "last_modified": self.remote_last_modified,
                "download_url": self.download_url,
            }
            version_file = os.path.join(self.new_dir, ".version.json")
            with open(version_file, "w", encoding="utf-8") as fh:
                json.dump(metadata, fh)

            if os.path.exists(self.app_dir):
                if os.path.exists(self.old_dir):
                    shutil.rmtree(self.old_dir)
                os.rename(self.app_dir, self.old_dir)

            os.rename(self.new_dir, self.app_dir)
            if is_privileged_mode():
                make_world_readable(self.app_dir)
                configure_chrome_sandbox(self.app_dir)
            else:
                chown_to_user(self.app_dir)
            print(f"Update complete: {self.app_name} installed to {self.app_dir}")

            write_desktop_entry(self.app_name, self.app_dir)

        except RuntimeError as exc:
            print(f"Error during update: {exc}", file=sys.stderr)
            if os.path.exists(self.new_dir):
                shutil.rmtree(self.new_dir)
        finally:
            if os.path.exists(self.old_dir):
                try:
                    shutil.rmtree(self.old_dir)
                except OSError:
                    pass


def check_and_update(
    app_name, force=False, privileged=None
):  # pylint: disable=too-many-locals,too-many-branches,too-many-statements
    """Check for a newer version of *app_name* and install it atomically if found."""
    paths = get_install_paths(privileged)
    user_home = get_user_home()
    config_dir = os.path.join(user_home, ".config", "antigravity")
    last_check_file = os.path.join(config_dir, f"last_check_{app_name}")
    opt_dir = paths["opt_dir"]
    app_dir = os.path.join(opt_dir, app_name)
    version_file = os.path.join(app_dir, ".version.json")

    should_check = force or _is_update_due(last_check_file)

    # Load installed metadata
    installed_metadata = {}
    if os.path.exists(version_file):
        try:
            with open(version_file, "r", encoding="utf-8") as fh:
                installed_metadata = json.load(fh)
        except (OSError, json.JSONDecodeError):
            pass

    if not should_check:
        if os.path.exists(app_dir):
            return
        print(f"Installation directory {app_dir} is missing. Forcing installation...")

    # If privileged mode is requested but we are not root, delegate update to sudo
    if paths["privileged"] and os.getuid() != 0:
        curr_script = os.path.abspath(sys.argv[0])
        cmd = [
            "sudo",
            "-n",
            sys.executable,
            curr_script,
            f"--internal-update={app_name}",
        ]
        if force:
            cmd.append("--update")
        try:
            res = subprocess.run(cmd, check=False)
            if res.returncode != 0:
                print(
                    f"Warning: Privileged update failed with exit code {res.returncode}.",
                    file=sys.stderr,
                )
        except (OSError, subprocess.SubprocessError) as exc:
            print(f"Warning: Could not invoke sudo for update: {exc}", file=sys.stderr)
        return

    print(f"Checking for updates for {app_name}...")
    _save_check_timestamp(config_dir, last_check_file)

    try:
        download_url, remote_last_modified = discover_download_url(app_name)
    except RuntimeError as exc:
        print(
            f"Warning: Failed to discover release info: {exc}. "
            "Proceeding with installed version if available.",
            file=sys.stderr,
        )
        return

    installed_last_modified = installed_metadata.get("last_modified")
    if os.path.exists(app_dir) and installed_last_modified == remote_last_modified:
        print(f"{app_name} is up-to-date.")
        write_desktop_entry(app_name, app_dir, privileged=paths["privileged"])
        return

    print(f"New version available (Released: {remote_last_modified})")

    os.makedirs(opt_dir, exist_ok=True)
    if not paths["privileged"]:
        chown_to_user(opt_dir)
    if not os.access(opt_dir, os.W_OK):
        print(
            f"Error: No write permission to {opt_dir}. Skipping update.",
            file=sys.stderr,
        )
        return

    new_dir = app_dir + ".new"
    old_dir = app_dir + ".old"

    if os.path.exists(new_dir):
        shutil.rmtree(new_dir)
    os.makedirs(new_dir, exist_ok=True)
    if not paths["privileged"]:
        chown_to_user(new_dir)

    updater = Updater(app_name)
    updater.set_download_url(download_url)
    updater.set_remote_last_modified(remote_last_modified)
    updater.set_new_dir(new_dir)
    updater.set_old_dir(old_dir)
    updater.set_app_dir(app_dir)
    updater.set_opt_dir(opt_dir)
    updater.perform()


# ---------------------------------------------------------------------------
# Desktop integration
# ---------------------------------------------------------------------------


def write_desktop_entry(
    app_name, app_dir, privileged=None
):  # pylint: disable=too-many-locals
    """Write a ``.desktop`` launcher for *app_name*."""
    paths = get_install_paths(privileged)
    apps_dir = paths["apps_dir"]
    desktop_file = os.path.join(apps_dir, f"{app_name}.desktop")
    wrapper_bin = os.path.join(paths["bin_dir"], app_name)

    if not find_file_recursive(app_dir, app_name, is_executable=True):
        print(
            f"Warning: Executable '{app_name}' not found in {app_dir}. "
            "Skipping .desktop file creation.",
            file=sys.stderr,
        )
        return

    icon_path = find_icon_recursive(app_dir, app_name) or "utilities-terminal"
    display_name = "Antigravity IDE" if app_name == "antigravity-ide" else "Antigravity"
    comment = (
        "Google Antigravity IDE"
        if app_name == "antigravity-ide"
        else "Google Antigravity Platform"
    )

    desktop_content = (
        f"[Desktop Entry]\n"
        f"Name={display_name}\n"
        f"Comment={comment}\n"
        f"Exec={wrapper_bin} --no-notifications %U\n"
        f"Icon={icon_path}\n"
        f"Terminal=false\n"
        f"Type=Application\n"
        f"Categories=Development;\n"
    )
    try:
        if paths["privileged"] and os.getuid() != 0 and can_use_sudo():
            with tempfile.NamedTemporaryFile("w", encoding="utf-8", delete=False) as tf:
                tf.write(desktop_content)
                tmp_path = tf.name
            try:
                subprocess.run(["sudo", "-n", "mkdir", "-p", apps_dir], check=False)
                res = subprocess.run(
                    ["sudo", "-n", "cp", tmp_path, desktop_file], check=False
                )
                if res.returncode == 0:
                    subprocess.run(
                        ["sudo", "-n", "chmod", "755", desktop_file], check=False
                    )
            finally:
                if os.path.exists(tmp_path):
                    try:
                        os.remove(tmp_path)
                    except OSError:
                        pass
        else:
            os.makedirs(apps_dir, exist_ok=True)
            if not paths["privileged"]:
                chown_to_user(apps_dir)
            with open(desktop_file, "w", encoding="utf-8") as fh:
                fh.write(desktop_content)
            os.chmod(desktop_file, 0o755)
            if not paths["privileged"]:
                chown_to_user(desktop_file)
    except OSError as exc:
        print(
            f"Warning: Failed to create desktop launcher {desktop_file}: {exc}",
            file=sys.stderr,
        )


# ---------------------------------------------------------------------------
# Password store / Keyring integration
# ---------------------------------------------------------------------------


def detect_password_store():  # pylint: disable=too-many-return-statements
    """Detect the appropriate password-store backend for the Linux environment.

    Returns one of: 'gnome-libsecret', 'kwallet6', 'kwallet5', 'kwallet', 'basic'.
    """
    env_override = os.environ.get("ANTIGRAVITY_PASSWORD_STORE")
    if env_override:
        return env_override

    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").upper()
    is_kde = "KDE" in desktop or "KDE_FULL_SESSION" in os.environ

    if is_kde:
        if shutil.which("kwalletd6"):
            return "kwallet6"
        if shutil.which("kwalletd5"):
            return "kwallet5"
        if shutil.which("kwalletd"):
            return "kwallet"
        if shutil.which("gnome-keyring-daemon") or shutil.which("secret-tool"):
            return "gnome-libsecret"
        return "kwallet5"

    if (
        shutil.which("gnome-keyring-daemon")
        or shutil.which("secret-tool")
        or shutil.which("keepassxc")
        or os.path.exists("/usr/bin/gnome-keyring-daemon")
    ):
        return "gnome-libsecret"

    if shutil.which("kwalletd6"):
        return "kwallet6"
    if shutil.which("kwalletd5"):
        return "kwallet5"
    if shutil.which("kwalletd"):
        return "kwallet"

    if any(
        d in desktop
        for d in (
            "GNOME",
            "UNITY",
            "CINNAMON",
            "MATE",
            "XFCE",
            "PANTHEON",
            "COSMIC",
        )
    ):
        return "gnome-libsecret"

    return "basic"


def update_argv_json(app_name, store):
    """Ensure ~/.<app_name>/argv.json contains the configured password-store."""
    user_home = get_user_home()
    config_dir = os.path.join(user_home, f".{app_name}")
    argv_path = os.path.join(config_dir, "argv.json")

    try:
        os.makedirs(config_dir, exist_ok=True)
        chown_to_user(config_dir)

        if not os.path.exists(argv_path):
            content = f'{{\n\t"password-store": "{store}"\n}}\n'
            with open(argv_path, "w", encoding="utf-8") as fh:
                fh.write(content)
            chown_to_user(argv_path)
            return

        with open(argv_path, "r", encoding="utf-8") as fh:
            content = fh.read()

        if "password-store" in content:
            return

        last_brace = content.rfind("}")
        if last_brace != -1:
            prefix = content[:last_brace].rstrip()
            if prefix and not prefix.endswith("{") and not prefix.endswith(","):
                prefix += ","
            new_content = prefix + f'\n\t"password-store": "{store}"\n}}\n'
            with open(argv_path, "w", encoding="utf-8") as fh:
                fh.write(new_content)
            chown_to_user(argv_path)
    except OSError as exc:
        print(f"Warning: Could not update {argv_path}: {exc}", file=sys.stderr)


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------


def main():
    """Detect the target app, check for updates, then exec the installed binary."""
    internal_app = None
    for a in sys.argv[1:]:
        if a.startswith("--internal-update="):
            internal_app = a.split("=", 1)[1]
            break
    if internal_app:
        self_install(privileged=True)
        check_and_update(internal_app, force=True, privileged=True)
        sys.exit(0)

    self_update()
    is_ide = "ide" in os.path.basename(sys.argv[0]).lower()
    app_name = "antigravity-ide" if is_ide else "antigravity"
    force_update = "--update" in sys.argv
    # On ChromeOS (Crostini) there is no system-level way to silence
    # Antigravity's desktop notifications, and they can cover the interaction
    # buttons in agent workflows.  Wrapping the exec with dbus-run-session
    # gives the app an isolated, transient D-Bus session so notifications
    # never reach the real desktop session bus, without affecting core
    # functionality.
    no_notifications = (
        "--no-notifications" in sys.argv
        or os.environ.get("ANTIGRAVITY_NOTIFICATIONS", "").lower() == "no"
    )

    self_install()
    check_and_update(app_name, force=force_update)

    store = detect_password_store()
    if store:
        update_argv_json(app_name, store)

    if force_update:
        print("Update operation completed.")
        sys.exit(0)

    app_dir = resolve_app_dir(app_name)
    resolved_bin = find_file_recursive(app_dir, app_name, is_executable=True)

    if not resolved_bin:
        print(
            f"Error: {app_name} is not installed and could not be loaded.",
            file=sys.stderr,
        )
        print(
            "Please check your internet connection and run again to install.",
            file=sys.stderr,
        )
        sys.exit(1)

    filtered_args = [
        a
        for a in sys.argv[1:]
        if a not in ("--update", "--no-notifications", "--system", "--user")
        and not a.startswith("--internal-update")
    ]
    if not is_sandbox_usable(app_dir) and "--no-sandbox" not in filtered_args:
        filtered_args.append("--no-sandbox")
    if store and not any(a.startswith("--password-store") for a in filtered_args):
        filtered_args.append(f"--password-store={store}")
    if no_notifications and shutil.which("dbus-run-session"):
        exec_bin = shutil.which("dbus-run-session")
        exec_args = [exec_bin, "--", resolved_bin] + filtered_args
    else:
        exec_bin = resolved_bin
        exec_args = [resolved_bin] + filtered_args
    try:
        os.execv(exec_bin, exec_args)
    except OSError as exc:
        print(f"Error: Failed to execute {resolved_bin}: {exc}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
